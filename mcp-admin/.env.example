# ==========================================
# MCP ADMIN - ENVIRONMENT CONFIGURATION EXAMPLE
# ==========================================

# Ambiente de Execução
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://admin.seu-dominio.com

# Identificação do Servidor MCP
MCP_SERVER_NAME=farm-mcp-control
MCP_SERVER_VERSION=1.0.0

# Autenticação MCP (Token Bearer para clientes AI/externos)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_ACCESS_TOKEN=

# Conexão com Game API e Banco
GAME_API_URL=https://api-jogo.seu-dominio.com
GAME_API_TOKEN=
DATABASE_URL=file:./data/mcp_admin.db

# Segredos de Sessão e Auth Administrativa
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ADMIN_JWT_SECRET=

# Feature Flags de Produção e Segurança
ADMIN_WRITE_MODE=false
ENABLE_DIAMOND_TOOLS=false
ENABLE_BAN_TOOLS=false

# Limites de Exportação e Rate Limit
MAX_EXPORT_ROWS=1000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Retenção de Logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=180
